# Copy to .env and fill in what you use.

# Which LLM writes answers and grades them:
#   groq | gemini | anthropic | ollama | openai_compatible | none
# If unset, the first provider whose key is filled in below is used.
LLM_PROVIDER=groq
# Optional: override the provider's default model (check the provider's model list)
LLM_MODEL=
# Seconds to wait between calls, to stay under free-tier per-minute limits
LLM_MIN_INTERVAL=2

# Groq free tier: https://console.groq.com
GROQ_API_KEY=
# Google Gemini free tier: https://aistudio.google.com
GEMINI_API_KEY=

# Anthropic (paid API)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5

# Ollama (free, local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Any other OpenAI-compatible API
LLM_BASE_URL=
LLM_API_KEY=

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
SQLITE_PATH=data/pka.db
CORPUS_DIR=data/corpus

# Summaries on a different provider/model than answers (optional; default: same provider)
SUMMARY_PROVIDER=
SUMMARY_MODEL=

# Phase 7: also search alternative wordings of each question (1 small API call per new question)
QUERY_REWRITE=0

# Pin "today" for reproducible evals of "now" questions (optional), e.g. 2026-11-13
PKA_TODAY=
